<Window
    x:Class="Zaclip.View.Settings.Contents.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zaclip.View.Settings.Contents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LoginDialog"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="メールアドレス" />
            <TextBox
                x:Name="txtEmail"
                Height="35"
                Margin="0,5,0,0"
                Padding="10"
                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,15,0,0" Text="パスワード" />

            <PasswordBox
                x:Name="txtPassword"
                Height="35"
                Margin="0,5,0,0"
                Padding="10" />

            <TextBlock Foreground="Red" Text="{Binding ErrorMessage}" />

        </StackPanel>

        <Button
            Grid.Row="2"
            Width="100"
            Height="35"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Command="{Binding LoginCommand}"
            Content="ログイン" />

        <Grid Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <ProgressBar
                    Width="200"
                    Height="6"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="ログイン中..." />

            </StackPanel>

        </Grid>
    </Grid>
</Window>
