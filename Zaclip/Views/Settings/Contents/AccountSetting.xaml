<UserControl
    x:Class="Zaclip.View.Settings.Contents.AccountSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zaclip.View.Settings.Contents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="20">

        <TextBlock FontSize="20" Text="アカウント" />

        <TextBlock Margin="0,20,0,0" Text="未ログイン" />

        <Button
            x:Name="LoginButton"
            Width="120"
            Margin="0,20,0,0"
            Click="LoginButton_Click"
            Content="ログイン" />

    </StackPanel>
</UserControl>
