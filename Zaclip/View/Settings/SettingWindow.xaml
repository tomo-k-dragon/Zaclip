<Window x:Class="Zaclip.View.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zaclip.View"
        mc:Ignorable="d"
        Title="SettingWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左サイドバー -->
        <ListBox x:Name="MenuListBox"
                 SelectionChanged="MenuListBox_SelectionChanged">
            <ListBoxItem Content="一般"/>
            <ListBoxItem Content="アカウント"/>
        </ListBox>

        <!-- 右コンテンツ -->
        <ContentControl x:Name="ContentArea"
                        Grid.Column="1"/>
    </Grid>
</Window>
